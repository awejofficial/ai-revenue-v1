# ============================================================
# AI Revenue Recovery Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All integrations gracefully fall back to mock/simulation
# mode when API keys are missing or DRY_RUN=true.
# ============================================================

# --- Execution Mode ---
# true  = Safe simulation (mock payment links, mock emails, mock SMS)
# false = Live production (real Stripe, Razorpay, SendGrid, Twilio, Slack calls)
DRY_RUN=true

# --- AI Diagnostics (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Database ---
# Leave blank or unset to use automatic zero-config SQLite fallback
DATABASE_URL=postgresql://postgres:password@localhost:5432/revenue_db
REDIS_URL=redis://localhost:6379/0

# --- Payment Gateways ---
PREFERRED_PSP=stripe
STRIPE_API_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# --- Communications ---
FROM_EMAIL=recovery@yourdomain.com
SENDGRID_API_KEY=SG.your_sendgrid_key
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
